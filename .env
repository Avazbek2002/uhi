# ── Cloudflare R2 credentials ─────────────────────────────────────────────
# Create an R2 API token at: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Name of the target R2 bucket
R2_BUCKET_NAME=landsat-lst-scenes

# Public domain for the R2 bucket (enable public access in the R2 dashboard)
# Format: pub-<hash>.r2.dev  (found in R2 bucket settings → Public Access)
R2_PUBLIC_DOMAIN=pub-ec33c8a1d13f40f4935fa09d39bb00ce.r2.dev

# ── Google Earth Engine ───────────────────────────────────────────────────
# Your GEE cloud project ID (create one at: https://code.earthengine.google.com)
GEE_PROJECT=your-gee-project-id

# ── TiTiler ───────────────────────────────────────────────────────────────
# Base URL of your TiTiler instance. Leave empty to skip tile URL generation.
# Self-hosted: https://your-titiler.example.com
# Or use the public demo (rate-limited): https://titiler.xyz
TITILER_HOST=https://titiler.xyz
