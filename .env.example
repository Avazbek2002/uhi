VITE_MAPBOX_TOKEN=pk.your_public_token_here

# ── COG Manifest (primary) ────────────────────────────────────────────────
# R2 public URL for the scene manifest generated by backend/process_lst_cog.py
# New format: { "scenes": [{ "date", "cog_url", "tile_url", "stats" }] }
VITE_LST_MANIFEST_URL=https://pub-ec33c8a1d13f40f4935fa09d39bb00ce.r2.dev/lst-cog/manifest.json

# ── Optional overrides ────────────────────────────────────────────────────
# If manifest tile_url is absent, you can set a static tile URL here.
# TiTiler XYZ template — tile_url from the manifest takes precedence.
# VITE_LST_RASTER_TILE_URL=https://titiler.xyz/cog/tiles/WebMercatorQuad/{z}/{x}/{y}.png?url=...&colormap_name=inferno&rescale=20,65&nodata=-9999

# Client-side GeoTIFF rendering fallback (slow, not recommended for production)
# VITE_LST_GEOTIFF_URL=https://pub-abc.r2.dev/lst-cog/tashkent_lst_2024-06-04.tif

# Single static PNG fallback (legacy, use manifest instead)
# VITE_LST_RASTER_URL=https://pub-abc.r2.dev/landsat-lst-scenes/tashkent_2024-06-04.png
